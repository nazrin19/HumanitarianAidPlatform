{
  "ConnectionStrings": {
    "Default": "Server=(localdb)\\mssqllocaldb;Database=HumanitarianAidPlatformDb;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "Jwt": {
    "Issuer": "HumanitarianAidPlatform",
    "Audience": "HumanitarianAidPlatformUsers",
    "ExpiryMinutes": 60
  },
  "Ai": {
    "Classifier": "RuleBased"
  },
  "Geocoding": {
    "Nominatim": {
      "BaseUrl": "https://nominatim.openstreetmap.org/",
      "UserAgent": "HumanitarianAidPlatform/1.0 (contact: replace-with-real-contact@example.org)",
      "TimeoutSeconds": 10,
      "MaximumCandidates": 5,
      "MaximumRetries": 2
    }
  },
  "Notifications": {
    "ProviderMode": "Sandbox",
    "Providers": {
      "Email": {
        "Enabled": true,
        "TimeoutSeconds": 10,
        "MaximumRetries": 2,
        "Smtp": {
          "Host": "",
          "Port": 587,
          "Username": "",
          "Password": "",
          "From": "",
          "EnableSsl": true
        }
      },
      "Sms": {
        "Enabled": true,
        "TimeoutSeconds": 10,
        "MaximumRetries": 2,
        "WebhookUrl": "",
        "BearerToken": ""
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}