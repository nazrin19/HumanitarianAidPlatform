{
  "ConnectionStrings": {
    "Default": "Server=(localdb)\\mssqllocaldb;Database=HumanitarianAidPlatformDb;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "Jwt": {
    "Issuer": "HumanitarianAidPlatform",
    "Audience": "HumanitarianAidPlatformUsers",
    "ExpiryMinutes": 60
  },
  "Ai": {
    "Classifier": "RuleBased"
  },
  "Geocoding": {
    "Nominatim": {
      "BaseUrl": "https://nominatim.openstreetmap.org/",
      "UserAgent": "HumanitarianAidPlatform/1.0 (contact: replace-with-real-contact@example.org)",
      "TimeoutSeconds": 10,
      "MaximumCandidates": 5,
      "MaximumRetries": 2
    }
  },
  "Notifications": {
    "Providers": {
      "Email": {
        "Mode": "Sandbox",
        "Enabled": true
      },
      "Sms": {
        "Mode": "Sandbox",
        "Enabled": true
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}